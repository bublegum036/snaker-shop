{
  "name": "sneaker-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-p lint:eslint lint:styles",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\" --max-warnings 0",
    "lint:fix": "run-s lint:eslint:fix lint:styles:fix",
    "lint:eslint:fix": "npm run lint:eslint -- --fix",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "check": "run-s lint build check:scenarios",
    "check:scenarios": "run-s check:auth check:cart check:checkout check:orders check:admin-products check:notifications check:admin-inventory check:admin-orders check:router",
    "check:auth": "node scripts/check-auth.mjs",
    "check:cart": "node scripts/check-cart.mjs",
    "check:checkout": "node scripts/check-checkout.mjs",
    "check:orders": "node scripts/check-orders.mjs",
    "check:admin-products": "node scripts/check-admin-products.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "check:admin-inventory": "node scripts/check-admin-inventory.mjs",
    "check:admin-orders": "node scripts/check-admin-orders.mjs",
    "check:router": "node scripts/check-router.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.0.4"
  }
}
